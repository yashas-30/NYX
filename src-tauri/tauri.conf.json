{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NYX",
  "version": "0.5.0",
  "identifier": "com.nyx.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nyx/web dev",
    "beforeBuildCommand": "pnpm --filter @nyx/web build",
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "NYX",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' blob: data:",
        "worker-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com data:",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https: wss: data: blob:",
        "img-src": "'self' data: https: blob: asset: http://asset.localhost",
        "media-src": "'self' data: https: blob: asset: http://asset.localhost"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../apps/web/dist"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "signingIdentity": null,
      "entitlements": null
    },
    "linux": { "deb": { "depends": [] } }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "",
      "endpoints": ["https://github.com/yashas-30/NYX/releases/latest/download/latest.json"]
    }
  }
}
